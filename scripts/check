#!/usr/bin/env bash
# Única definição dos portões de qualidade. Hook, CI e pessoas rodam este mesmo script.
#   scripts/check          completo (antes de push e no CI)
#   scripts/check --fast   só o que é rápido (pre-commit): estático, arquitetura, governança
# Variável opcional CHECK_BASE: ref git usada como base nas comparações (padrão: origin/main).
set -uo pipefail

cd "$(dirname "$0")/.."
FAST=0
[[ "${1:-}" == "--fast" ]] && FAST=1

VENV_BIN="backend/.venv/bin"
if [[ ! -x "$VENV_BIN/ruff" ]]; then
    echo "ambiente do backend ausente. Rode: (cd backend && uv venv && uv pip install -e '.[dev]')" >&2
    exit 2
fi

FAILED=()
run() {
    local name="$1"
    shift
    printf '\n=== %s\n' "$name"
    if ! "$@"; then
        FAILED+=("$name")
    fi
}
in_dir() {
    local dir="$1"
    shift
    (cd "$dir" && "$@")
}

# --- backend ---------------------------------------------------------------------
run "ruff check" in_dir backend .venv/bin/ruff check . ../scripts --config pyproject.toml
run "ruff docstrings" in_dir backend .venv/bin/ruff check src --select D --ignore D105,D107 --config pyproject.toml
run "ruff format" in_dir backend .venv/bin/ruff format --check . ../scripts --config pyproject.toml
run "mypy" in_dir backend .venv/bin/mypy
run "import-linter" in_dir backend .venv/bin/lint-imports

# --- políticas do repositório (stdlib; exigem python3 >= 3.11 por causa de tomllib) --
run "governança" python3 scripts/check_governance.py
run "supressões" python3 scripts/check_suppressions.py
if [[ $FAST -eq 0 ]]; then
    run "atribuição" python3 scripts/check_attribution.py
fi

HAS_NODE=0
if [[ -d frontend/node_modules ]]; then
    HAS_NODE=1
else
    printf '\n=== frontend\n!!! SKIP: frontend/node_modules ausente (rode: cd frontend && npm install).\n!!! Prettier, tsc e contrato NÃO foram verificados.\n'
fi

# O app Angular tem o próprio package.json (TypeScript na faixa do Angular). Em CI, faltar o
# node_modules dele é erro: um SKIP verde esconderia um front quebrado.
HAS_APP=0
if [[ -d frontend/app/node_modules ]]; then
    HAS_APP=1
elif [[ -n "${CI:-}" ]]; then
    printf '\n=== frontend/app\n!!! FALHA: frontend/app/node_modules ausente em CI (falta o npm ci).\n'
    FAILED+=("frontend/app sem dependências")
else
    printf '\n=== frontend/app\n!!! SKIP: frontend/app/node_modules ausente (rode: cd frontend/app && npm install).\n!!! Lint, testes e build do app NÃO foram verificados.\n'
fi

if [[ $HAS_NODE -eq 1 ]]; then
    run "prettier" in_dir frontend npx --no-install prettier --check .
fi

if [[ $FAST -eq 0 ]]; then
    run "pytest + cobertura" in_dir backend .venv/bin/pytest -q --cov --cov-report=term:skip-covered
    if [[ $HAS_NODE -eq 1 ]]; then
        run "tsc" in_dir frontend npm run --silent typecheck
        run "contrato em dia" bash scripts/check_contract.sh
    fi
    if [[ $HAS_APP -eq 1 ]]; then
        run "lint (app)" in_dir frontend/app npm run --silent lint
        run "testes de ferramenta (app)" in_dir frontend/app npm run --silent test:tools
        run "build (app)" in_dir frontend/app npm run --silent build
        run "testes (app)" in_dir frontend/app npm run --silent test
    fi
fi

printf '\n'
if [[ ${#FAILED[@]} -gt 0 ]]; then
    printf 'FALHOU: %s\n' "${FAILED[*]}" >&2
    exit 1
fi
echo "OK: todos os portões passaram."
