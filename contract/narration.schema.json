{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Um pacote de narração: regras de texto por tipo de evento, em JSON.",
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "type": "integer"
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "rules": {
      "additionalProperties": {
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "type": "array"
      },
      "minProperties": 1,
      "type": "object"
    }
  },
  "required": [
    "id",
    "language",
    "rules"
  ],
  "title": "NarrationPack",
  "type": "object"
}
