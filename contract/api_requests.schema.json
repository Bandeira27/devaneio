{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "CommandRequest": {
      "additionalProperties": false,
      "description": "Um comando: a linha e a revisão da mesa que o cliente viu.",
      "properties": {
        "line": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        "revision": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "line",
        "revision"
      ],
      "title": "CommandRequest",
      "type": "object"
    },
    "CopilotRequest": {
      "additionalProperties": false,
      "description": "Pergunta avulsa ao copiloto do anfitrião (sem estado: cada chamada leva o contexto atual).",
      "properties": {
        "text": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "CopilotRequest",
      "type": "object"
    },
    "CreateTableRequest": {
      "additionalProperties": false,
      "description": "Criar uma mesa: a campanha, o nome do anfitrião e, opcionalmente, a semente.",
      "properties": {
        "campaign_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        "host_name": {
          "maxLength": 40,
          "minLength": 1,
          "type": "string"
        },
        "seed": {
          "anyOf": [
            {
              "exclusiveMaximum": 9007199254740992,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "campaign_id",
        "host_name"
      ],
      "title": "CreateTableRequest",
      "type": "object"
    },
    "InvitePreviewRequest": {
      "additionalProperties": false,
      "description": "Espiar para onde um convite leva: só o código de convite.",
      "properties": {
        "invite_code": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "invite_code"
      ],
      "title": "InvitePreviewRequest",
      "type": "object"
    },
    "JoinRequest": {
      "additionalProperties": false,
      "description": "Entrar numa mesa: o código de convite e o nome.",
      "properties": {
        "invite_code": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "maxLength": 40,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "invite_code",
        "name"
      ],
      "title": "JoinRequest",
      "type": "object"
    },
    "LifecycleRequest": {
      "additionalProperties": false,
      "description": "Uma mudança de fase da mesa, pedida pelo anfitrião: iniciar, pausar, retomar ou encerrar.",
      "properties": {
        "action": {
          "enum": [
            "start",
            "pause",
            "resume",
            "end"
          ],
          "type": "string"
        },
        "revision": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "action",
        "revision"
      ],
      "title": "LifecycleRequest",
      "type": "object"
    },
    "SaveRequest": {
      "additionalProperties": false,
      "description": "A campanha a gravar: o servidor a valida de novo e só grava sem erro.",
      "properties": {
        "campaign": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "required": [
        "campaign"
      ],
      "title": "SaveRequest",
      "type": "object"
    },
    "SayRequest": {
      "additionalProperties": false,
      "description": "Um texto livre para o mestre de IA: o texto e a revisão que o cliente viu.",
      "properties": {
        "text": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        "revision": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "text",
        "revision"
      ],
      "title": "SayRequest",
      "type": "object"
    },
    "ValidateRequest": {
      "additionalProperties": false,
      "description": "A campanha como o editor a tem agora, ainda sem passar pela validação (JSON cru).",
      "properties": {
        "campaign": {
          "additionalProperties": true,
          "type": "object"
        }
      },
      "required": [
        "campaign"
      ],
      "title": "ValidateRequest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Todos os corpos de requisição, reunidos só para gerar o contrato.",
  "properties": {
    "create_table": {
      "$ref": "#/$defs/CreateTableRequest"
    },
    "join_table": {
      "$ref": "#/$defs/JoinRequest"
    },
    "invite_preview": {
      "$ref": "#/$defs/InvitePreviewRequest"
    },
    "command": {
      "$ref": "#/$defs/CommandRequest"
    },
    "lifecycle": {
      "$ref": "#/$defs/LifecycleRequest"
    },
    "say": {
      "$ref": "#/$defs/SayRequest"
    },
    "copilot": {
      "$ref": "#/$defs/CopilotRequest"
    },
    "editor_validate": {
      "$ref": "#/$defs/ValidateRequest"
    },
    "editor_save": {
      "$ref": "#/$defs/SaveRequest"
    }
  },
  "required": [
    "create_table",
    "join_table",
    "invite_preview",
    "command",
    "lifecycle",
    "say",
    "copilot",
    "editor_validate",
    "editor_save"
  ],
  "title": "ApiRequests",
  "type": "object"
}
