{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "CommandRequest": {
      "additionalProperties": false,
      "properties": {
        "line": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        "revision": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "line",
        "revision"
      ],
      "title": "CommandRequest",
      "type": "object"
    },
    "CreateTableRequest": {
      "additionalProperties": false,
      "properties": {
        "campaign_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        "host_name": {
          "maxLength": 40,
          "minLength": 1,
          "type": "string"
        },
        "seed": {
          "anyOf": [
            {
              "exclusiveMaximum": 9007199254740992,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "campaign_id",
        "host_name"
      ],
      "title": "CreateTableRequest",
      "type": "object"
    },
    "JoinRequest": {
      "additionalProperties": false,
      "properties": {
        "invite_code": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "maxLength": 40,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "invite_code",
        "name"
      ],
      "title": "JoinRequest",
      "type": "object"
    },
    "SayRequest": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
        },
        "revision": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "text",
        "revision"
      ],
      "title": "SayRequest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "create_table": {
      "$ref": "#/$defs/CreateTableRequest"
    },
    "join_table": {
      "$ref": "#/$defs/JoinRequest"
    },
    "command": {
      "$ref": "#/$defs/CommandRequest"
    },
    "say": {
      "$ref": "#/$defs/SayRequest"
    }
  },
  "required": [
    "create_table",
    "join_table",
    "command",
    "say"
  ],
  "title": "ApiRequests",
  "type": "object"
}
