{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "BeatStatus": {
      "enum": [
        "pending",
        "active",
        "done",
        "failed"
      ],
      "title": "BeatStatus",
      "type": "string"
    },
    "Character": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "attributes": {
          "additionalProperties": {
            "type": "integer"
          },
          "default": {},
          "title": "Attributes",
          "type": "object"
        },
        "hp": {
          "title": "Hp",
          "type": "integer"
        },
        "max_hp": {
          "minimum": 0,
          "title": "Max Hp",
          "type": "integer"
        },
        "inventory": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Inventory",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "attributes",
        "hp",
        "max_hp",
        "inventory"
      ],
      "title": "Character",
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "description": "Entrada do log. Provisório: ``data`` é genérico até o motor de regras definir\nos tipos de evento (aí vira união discriminada por ``kind``).",
      "properties": {
        "turn": {
          "minimum": 0,
          "title": "Turn",
          "type": "integer"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        },
        "data": {
          "additionalProperties": true,
          "default": {},
          "title": "Data",
          "type": "object"
        }
      },
      "required": [
        "turn",
        "kind",
        "text",
        "data"
      ],
      "title": "Event",
      "type": "object"
    },
    "Fact": {
      "additionalProperties": false,
      "description": "Memória externa do narrador: algo estabelecido na ficção, com o turno em que surgiu.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "turn": {
          "minimum": 0,
          "title": "Turn",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "text",
        "turn"
      ],
      "title": "Fact",
      "type": "object"
    },
    "NpcState": {
      "additionalProperties": false,
      "properties": {
        "alive": {
          "default": true,
          "title": "Alive",
          "type": "boolean"
        },
        "disposition": {
          "default": 0,
          "title": "Disposition",
          "type": "integer"
        },
        "location_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location Id"
        }
      },
      "required": [
        "alive",
        "disposition",
        "location_id"
      ],
      "title": "NpcState",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "state_version": {
      "const": 1,
      "default": 1,
      "title": "State Version",
      "type": "integer"
    },
    "campaign_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "title": "Campaign Id",
      "type": "string"
    },
    "turn": {
      "default": 0,
      "minimum": 0,
      "title": "Turn",
      "type": "integer"
    },
    "rng_seed": {
      "title": "Rng Seed",
      "type": "integer"
    },
    "rng_draws": {
      "default": 0,
      "minimum": 0,
      "title": "Rng Draws",
      "type": "integer"
    },
    "current_location_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "title": "Current Location Id",
      "type": "string"
    },
    "characters": {
      "default": {},
      "patternProperties": {
        "^[a-z0-9][a-z0-9_-]*$": {
          "$ref": "#/$defs/Character"
        }
      },
      "title": "Characters",
      "type": "object"
    },
    "npcs": {
      "default": {},
      "patternProperties": {
        "^[a-z0-9][a-z0-9_-]*$": {
          "$ref": "#/$defs/NpcState"
        }
      },
      "title": "Npcs",
      "type": "object"
    },
    "beats": {
      "default": {},
      "patternProperties": {
        "^[a-z0-9][a-z0-9_-]*$": {
          "$ref": "#/$defs/BeatStatus"
        }
      },
      "title": "Beats",
      "type": "object"
    },
    "facts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Fact"
      },
      "title": "Facts",
      "type": "array"
    },
    "events": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Event"
      },
      "title": "Events",
      "type": "array"
    }
  },
  "required": [
    "state_version",
    "campaign_id",
    "turn",
    "rng_seed",
    "rng_draws",
    "current_location_id",
    "characters",
    "npcs",
    "beats",
    "facts",
    "events"
  ],
  "title": "GameState",
  "type": "object"
}
