{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "BeatStatus": {
      "description": "Em que ponto um marco da trama está.",
      "enum": [
        "pending",
        "active",
        "done",
        "failed"
      ],
      "title": "BeatStatus",
      "type": "string"
    },
    "Character": {
      "additionalProperties": false,
      "description": "Um personagem de jogador, com atributos, hp e inventário.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "attributes": {
          "additionalProperties": {
            "type": "integer"
          },
          "default": {},
          "type": "object"
        },
        "hp": {
          "type": "integer"
        },
        "max_hp": {
          "minimum": 0,
          "type": "integer"
        },
        "inventory": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "attributes",
        "hp",
        "max_hp",
        "inventory"
      ],
      "title": "Character",
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "description": "Entrada do log.\n\n``kind`` diz o tipo do evento e ``data`` traz os detalhes dele, que variam por tipo.",
      "properties": {
        "turn": {
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "type": "string"
        },
        "text": {
          "default": "",
          "type": "string"
        },
        "data": {
          "additionalProperties": true,
          "default": {},
          "type": "object"
        }
      },
      "required": [
        "turn",
        "kind",
        "text",
        "data"
      ],
      "title": "Event",
      "type": "object"
    },
    "NpcState": {
      "additionalProperties": false,
      "description": "O que muda num NPC durante a partida: hp, onde está, se está de pé.\n\nhp 0 derruba o NPC (`alive=False`). Para personagens, hp 0 é \"fora de combate\": morte é\ndecisão narrativa, não do motor.",
      "properties": {
        "alive": {
          "default": true,
          "type": "boolean"
        },
        "hp": {
          "type": "integer"
        },
        "max_hp": {
          "minimum": 0,
          "type": "integer"
        },
        "attributes": {
          "additionalProperties": {
            "type": "integer"
          },
          "default": {},
          "type": "object"
        },
        "disposition": {
          "default": 0,
          "type": "integer"
        },
        "location_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "alive",
        "hp",
        "max_hp",
        "attributes",
        "disposition",
        "location_id"
      ],
      "title": "NpcState",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "O estado inteiro de uma partida: tudo que muda, em JSON puro.",
  "properties": {
    "state_version": {
      "const": 1,
      "default": 1,
      "type": "integer"
    },
    "campaign_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "type": "string"
    },
    "turn": {
      "default": 0,
      "minimum": 0,
      "type": "integer"
    },
    "rng_seed": {
      "type": "integer"
    },
    "rng_draws": {
      "default": 0,
      "minimum": 0,
      "type": "integer"
    },
    "current_location_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "type": "string"
    },
    "characters": {
      "default": {},
      "patternProperties": {
        "^[a-z0-9][a-z0-9_-]*$": {
          "$ref": "#/$defs/Character"
        }
      },
      "type": "object"
    },
    "npcs": {
      "default": {},
      "patternProperties": {
        "^[a-z0-9][a-z0-9_-]*$": {
          "$ref": "#/$defs/NpcState"
        }
      },
      "type": "object"
    },
    "beats": {
      "default": {},
      "patternProperties": {
        "^[a-z0-9][a-z0-9_-]*$": {
          "$ref": "#/$defs/BeatStatus"
        }
      },
      "type": "object"
    },
    "revealed_facts": {
      "default": {},
      "patternProperties": {
        "^[a-z0-9][a-z0-9_-]*$": {
          "type": "integer"
        }
      },
      "type": "object"
    },
    "events": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Event"
      },
      "type": "array"
    }
  },
  "required": [
    "state_version",
    "campaign_id",
    "turn",
    "rng_seed",
    "rng_draws",
    "current_location_id",
    "characters",
    "npcs",
    "beats",
    "revealed_facts",
    "events"
  ],
  "title": "GameState",
  "type": "object"
}
