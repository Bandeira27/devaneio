{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ApiError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ApiError",
      "type": "object"
    },
    "AtLocation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "at_location",
          "type": "string"
        },
        "location_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "location_id"
      ],
      "title": "AtLocation",
      "type": "object"
    },
    "Beat": {
      "additionalProperties": false,
      "description": "Marco da trama. ``requires`` lista marcos que precisam estar concluídos antes.\n\n``activate_when``: condições para passar de pendente a ativo (além dos requisitos);\nvazia, ativa assim que os requisitos estiverem concluídos.\n``complete_when``: condições para concluir automaticamente; vazia, só conclui por ação\nexplícita (o mestre/jogador decide).",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "default": "",
          "type": "string"
        },
        "requires": {
          "default": [],
          "items": {
            "pattern": "^[a-z0-9][a-z0-9_-]*$",
            "type": "string"
          },
          "type": "array"
        },
        "activate_when": {
          "default": [],
          "items": {
            "discriminator": {
              "mapping": {
                "at_location": "#/$defs/AtLocation",
                "beat_done": "#/$defs/BeatDone",
                "npc_down": "#/$defs/NpcDown",
                "turn_at_least": "#/$defs/TurnAtLeast"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/AtLocation"
              },
              {
                "$ref": "#/$defs/NpcDown"
              },
              {
                "$ref": "#/$defs/BeatDone"
              },
              {
                "$ref": "#/$defs/TurnAtLeast"
              }
            ]
          },
          "type": "array"
        },
        "complete_when": {
          "default": [],
          "items": {
            "discriminator": {
              "mapping": {
                "at_location": "#/$defs/AtLocation",
                "beat_done": "#/$defs/BeatDone",
                "npc_down": "#/$defs/NpcDown",
                "turn_at_least": "#/$defs/TurnAtLeast"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/AtLocation"
              },
              {
                "$ref": "#/$defs/NpcDown"
              },
              {
                "$ref": "#/$defs/BeatDone"
              },
              {
                "$ref": "#/$defs/TurnAtLeast"
              }
            ]
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "requires",
        "activate_when",
        "complete_when"
      ],
      "title": "Beat",
      "type": "object"
    },
    "BeatDone": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "beat_done",
          "type": "string"
        },
        "beat_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "beat_id"
      ],
      "title": "BeatDone",
      "type": "object"
    },
    "BeatInfo": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "title": "BeatInfo",
      "type": "object"
    },
    "BeatStatus": {
      "enum": [
        "pending",
        "active",
        "done",
        "failed"
      ],
      "title": "BeatStatus",
      "type": "string"
    },
    "Campaign": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "type": "integer"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "premise": {
          "type": "string"
        },
        "rules_id": {
          "default": "default",
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        "start_location_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        "locations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Location"
          },
          "type": "array"
        },
        "factions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Faction"
          },
          "type": "array"
        },
        "npcs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Npc"
          },
          "type": "array"
        },
        "beats": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Beat"
          },
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "id",
        "title",
        "premise",
        "rules_id",
        "start_location_id",
        "locations",
        "factions",
        "npcs",
        "beats"
      ],
      "title": "Campaign",
      "type": "object"
    },
    "CampaignSummary": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "premise": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "premise"
      ],
      "title": "CampaignSummary",
      "type": "object"
    },
    "CampaignView": {
      "additionalProperties": false,
      "description": "A campanha para um jogador comum: só o que o ``olhar`` do CLI mostra (título, premissa,\nlocal atual com saídas, NPCs ali, marcos que já começaram). Facções, condições dos\nmarcos, atributos, disposição, armas e a localização dos outros NPCs ficam com o\nanfitrião, que recebe a ``Campaign`` inteira.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "premise": {
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/LocationView"
        },
        "npcs": {
          "items": {
            "$ref": "#/$defs/NpcInfo"
          },
          "type": "array"
        },
        "beats": {
          "items": {
            "$ref": "#/$defs/BeatInfo"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "premise",
        "location",
        "npcs",
        "beats"
      ],
      "title": "CampaignView",
      "type": "object"
    },
    "Character": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "attributes": {
          "additionalProperties": {
            "type": "integer"
          },
          "default": {},
          "type": "object"
        },
        "hp": {
          "type": "integer"
        },
        "max_hp": {
          "minimum": 0,
          "type": "integer"
        },
        "inventory": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "attributes",
        "hp",
        "max_hp",
        "inventory"
      ],
      "title": "Character",
      "type": "object"
    },
    "CommandResult": {
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "integer"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/EventView"
          },
          "type": "array"
        },
        "text": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/GameStatus"
        },
        "turn_ended": {
          "type": "boolean"
        }
      },
      "required": [
        "revision",
        "events",
        "text",
        "status",
        "turn_ended"
      ],
      "title": "CommandResult",
      "type": "object"
    },
    "ErrorResponse": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "$ref": "#/$defs/ApiError"
        }
      },
      "required": [
        "error"
      ],
      "title": "ErrorResponse",
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "description": "Entrada do log. Provisório: ``data`` é genérico até o motor de regras definir\nos tipos de evento (aí vira união discriminada por ``kind``).",
      "properties": {
        "turn": {
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "type": "string"
        },
        "text": {
          "default": "",
          "type": "string"
        },
        "data": {
          "additionalProperties": true,
          "default": {},
          "type": "object"
        }
      },
      "required": [
        "turn",
        "kind",
        "text",
        "data"
      ],
      "title": "Event",
      "type": "object"
    },
    "EventView": {
      "additionalProperties": false,
      "description": "Evento do log para o cliente: sem ``data``. ``prose`` é sempre a narração da gramática\ndo próprio evento. ``narration`` é o parágrafo do LLM para o lote de uma ação de texto\nlivre, só no primeiro evento visível do lote (nos outros é ``None``) e só enquanto o\nservidor não reinicia. Os dois são exibição, nunca voltam ao estado, e são iguais para\ntodos os jogadores.",
      "properties": {
        "index": {
          "type": "integer"
        },
        "turn": {
          "type": "integer"
        },
        "kind": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "prose": {
          "type": "string"
        },
        "narration": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "index",
        "turn",
        "kind",
        "text",
        "prose",
        "narration"
      ],
      "title": "EventView",
      "type": "object"
    },
    "EventsView": {
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "integer"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/EventView"
          },
          "type": "array"
        },
        "talk": {
          "items": {
            "$ref": "#/$defs/TalkView"
          },
          "type": "array"
        },
        "talk_seq": {
          "default": 0,
          "type": "integer"
        }
      },
      "required": [
        "revision",
        "events",
        "talk",
        "talk_seq"
      ],
      "title": "EventsView",
      "type": "object"
    },
    "ExitView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "ExitView",
      "type": "object"
    },
    "Fact": {
      "additionalProperties": false,
      "description": "Memória externa do narrador: algo estabelecido na ficção, com o turno em que surgiu.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "turn": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "text",
        "turn"
      ],
      "title": "Fact",
      "type": "object"
    },
    "Faction": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "default": "",
          "type": "string"
        },
        "goals": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "goals"
      ],
      "title": "Faction",
      "type": "object"
    },
    "GameState": {
      "additionalProperties": false,
      "properties": {
        "state_version": {
          "const": 1,
          "default": 1,
          "type": "integer"
        },
        "campaign_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        "turn": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "rng_seed": {
          "type": "integer"
        },
        "rng_draws": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "current_location_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        "characters": {
          "default": {},
          "patternProperties": {
            "^[a-z0-9][a-z0-9_-]*$": {
              "$ref": "#/$defs/Character"
            }
          },
          "type": "object"
        },
        "npcs": {
          "default": {},
          "patternProperties": {
            "^[a-z0-9][a-z0-9_-]*$": {
              "$ref": "#/$defs/NpcState"
            }
          },
          "type": "object"
        },
        "beats": {
          "default": {},
          "patternProperties": {
            "^[a-z0-9][a-z0-9_-]*$": {
              "$ref": "#/$defs/BeatStatus"
            }
          },
          "type": "object"
        },
        "facts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Fact"
          },
          "type": "array"
        },
        "events": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Event"
          },
          "type": "array"
        }
      },
      "required": [
        "state_version",
        "campaign_id",
        "turn",
        "rng_seed",
        "rng_draws",
        "current_location_id",
        "characters",
        "npcs",
        "beats",
        "facts",
        "events"
      ],
      "title": "GameState",
      "type": "object"
    },
    "GameStatus": {
      "enum": [
        "active",
        "won",
        "lost"
      ],
      "title": "GameStatus",
      "type": "string"
    },
    "LlmView": {
      "additionalProperties": false,
      "description": "O LLM é do processo do servidor (ambiente de quem o roda); os jogadores veem se\nestá ligado e para onde o contexto da partida vai, antes de entrar.",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "notice": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "secrets": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "enabled",
        "description",
        "notice",
        "secrets"
      ],
      "title": "LlmView",
      "type": "object"
    },
    "Location": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "default": "",
          "type": "string"
        },
        "connections": {
          "default": [],
          "items": {
            "pattern": "^[a-z0-9][a-z0-9_-]*$",
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "connections"
      ],
      "title": "Location",
      "type": "object"
    },
    "LocationView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "exits": {
          "items": {
            "$ref": "#/$defs/ExitView"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "exits"
      ],
      "title": "LocationView",
      "type": "object"
    },
    "Npc": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "default": "",
          "type": "string"
        },
        "location_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "faction_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "secrets": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "attributes": {
          "additionalProperties": {
            "type": "integer"
          },
          "default": {},
          "type": "object"
        },
        "disposition": {
          "default": 0,
          "type": "integer"
        },
        "weapon_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "location_id",
        "faction_id",
        "secrets",
        "attributes",
        "disposition",
        "weapon_id"
      ],
      "title": "Npc",
      "type": "object"
    },
    "NpcDown": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "npc_down",
          "type": "string"
        },
        "npc_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "npc_id"
      ],
      "title": "NpcDown",
      "type": "object"
    },
    "NpcInfo": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "NpcInfo",
      "type": "object"
    },
    "NpcState": {
      "additionalProperties": false,
      "properties": {
        "alive": {
          "default": true,
          "type": "boolean"
        },
        "hp": {
          "type": "integer"
        },
        "max_hp": {
          "minimum": 0,
          "type": "integer"
        },
        "attributes": {
          "additionalProperties": {
            "type": "integer"
          },
          "default": {},
          "type": "object"
        },
        "disposition": {
          "default": 0,
          "type": "integer"
        },
        "location_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "alive",
        "hp",
        "max_hp",
        "attributes",
        "disposition",
        "location_id"
      ],
      "title": "NpcState",
      "type": "object"
    },
    "NpcView": {
      "additionalProperties": false,
      "description": "NPC como o ``olhar`` o mostra: vivo, hp e se está hostil. Atributos e disposição\nnuméricos (que revelam defesas e o limiar de hostilidade) ficam com o anfitrião.",
      "properties": {
        "alive": {
          "type": "boolean"
        },
        "hp": {
          "type": "integer"
        },
        "max_hp": {
          "type": "integer"
        },
        "hostile": {
          "type": "boolean"
        }
      },
      "required": [
        "alive",
        "hp",
        "max_hp",
        "hostile"
      ],
      "title": "NpcView",
      "type": "object"
    },
    "PlayerStateView": {
      "additionalProperties": false,
      "description": "O que um jogador comum vê do estado. Fica de fora: ``rng_seed``/``rng_draws`` (com eles\no próximo sorteio seria previsível), ``events`` (vêm por ``EventView``, sem ``data``) e\n``facts`` (memória do narrador, escrita com acesso aos segredos). NPCs só os do local\natual e só como ``NpcView``; marcos só os que já começaram. O anfitrião (mestre) recebe o\n``GameState`` inteiro. Campo novo de ``GameState`` não chega aqui sem ser listado em\n``of`` (e ``tests/test_server_models.py`` obriga a decidir).",
      "properties": {
        "state_version": {
          "const": 1,
          "type": "integer"
        },
        "campaign_id": {
