{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ApiError": {
      "additionalProperties": false,
      "description": "Um erro da API: um código estável e a mensagem em português.",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ApiError",
      "type": "object"
    },
    "AtLocation": {
      "additionalProperties": false,
      "description": "Vale quando o grupo está num local.",
      "properties": {
        "kind": {
          "const": "at_location",
          "type": "string"
        },
        "location_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "location_id"
      ],
      "title": "AtLocation",
      "type": "object"
    },
    "AttributeInfo": {
      "additionalProperties": false,
      "description": "Um atributo, com os limites e o valor padrão.",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "min": {
          "type": "integer"
        },
        "max": {
          "type": "integer"
        },
        "default": {
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "min",
        "max",
        "default"
      ],
      "title": "AttributeInfo",
      "type": "object"
    },
    "Beat": {
      "additionalProperties": false,
      "description": "Marco da trama. ``requires`` lista marcos que precisam estar concluídos antes.\n\n``activate_when``: condições para passar de pendente a ativo (além dos requisitos);\nvazia, ativa assim que os requisitos estiverem concluídos.\n``complete_when``: condições para concluir automaticamente; vazia, só conclui por ação\nexplícita (o mestre/jogador decide).",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "default": "",
          "type": "string"
        },
        "requires": {
          "default": [],
          "items": {
            "pattern": "^[a-z0-9][a-z0-9_-]*$",
            "type": "string"
          },
          "type": "array"
        },
        "activate_when": {
          "default": [],
          "items": {
            "discriminator": {
              "mapping": {
                "at_location": "#/$defs/AtLocation",
                "beat_done": "#/$defs/BeatDone",
                "check_passed": "#/$defs/CheckPassed",
                "npc_down": "#/$defs/NpcDown",
                "turn_at_least": "#/$defs/TurnAtLeast"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/AtLocation"
              },
              {
                "$ref": "#/$defs/NpcDown"
              },
              {
                "$ref": "#/$defs/BeatDone"
              },
              {
                "$ref": "#/$defs/TurnAtLeast"
              },
              {
                "$ref": "#/$defs/CheckPassed"
              }
            ]
          },
          "type": "array"
        },
        "complete_when": {
          "default": [],
          "items": {
            "discriminator": {
              "mapping": {
                "at_location": "#/$defs/AtLocation",
                "beat_done": "#/$defs/BeatDone",
                "check_passed": "#/$defs/CheckPassed",
                "npc_down": "#/$defs/NpcDown",
                "turn_at_least": "#/$defs/TurnAtLeast"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/AtLocation"
              },
              {
                "$ref": "#/$defs/NpcDown"
              },
              {
                "$ref": "#/$defs/BeatDone"
              },
              {
                "$ref": "#/$defs/TurnAtLeast"
              },
              {
                "$ref": "#/$defs/CheckPassed"
              }
            ]
          },
          "type": "array"
        },
        "private_notes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "requires",
        "activate_when",
        "complete_when",
        "private_notes"
      ],
      "title": "Beat",
      "type": "object"
    },
    "BeatDone": {
      "additionalProperties": false,
      "description": "Vale quando um marco foi concluído.",
      "properties": {
        "kind": {
          "const": "beat_done",
          "type": "string"
        },
        "beat_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "beat_id"
      ],
      "title": "BeatDone",
      "type": "object"
    },
    "BeatInfo": {
      "additionalProperties": false,
      "description": "Um marco que já começou.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "title": "BeatInfo",
      "type": "object"
    },
    "BeatStatus": {
      "description": "Em que ponto um marco da trama está.",
      "enum": [
        "pending",
        "active",
        "done",
        "failed"
      ],
      "title": "BeatStatus",
      "type": "string"
    },
    "Campaign": {
      "additionalProperties": false,
      "description": "A campanha: locais, NPCs, marcos e fatos, tudo estático (o que muda fica no `GameState`).",
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "type": "integer"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "premise": {
          "type": "string"
        },
        "rules_id": {
          "default": "default",
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        "narration_id": {
          "default": "pt-br",
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        "start_location_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        "locations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Location"
          },
          "type": "array"
        },
        "factions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Faction"
          },
          "type": "array"
        },
        "npcs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Npc"
          },
          "type": "array"
        },
        "beats": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Beat"
          },
          "type": "array"
        },
        "facts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/FactDef"
          },
          "type": "array"
        }
      },
      "required": [
        "schema_version",
        "id",
        "title",
        "premise",
        "rules_id",
        "narration_id",
        "start_location_id",
        "locations",
        "factions",
        "npcs",
        "beats",
        "facts"
      ],
      "title": "Campaign",
      "type": "object"
    },
    "CampaignSummary": {
      "additionalProperties": false,
      "description": "Uma campanha do catálogo: id, título e premissa.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "premise": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "premise"
      ],
      "title": "CampaignSummary",
      "type": "object"
    },
    "CampaignView": {
      "additionalProperties": false,
      "description": "A campanha como um jogador comum a vê.\n\nSó o que o ``olhar`` do CLI mostra (título, premissa, local atual com saídas, NPCs ali,\nmarcos que já começaram e fatos já revelados). Fatos ocultos, ``private_notes``, facções,\ncondições dos marcos, atributos, disposição, armas e a localização dos outros NPCs ficam com\no anfitrião, que recebe a ``Campaign`` inteira.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "premise": {
          "type": "string"
        },
        "location": {
          "$ref": "#/$defs/LocationView"
        },
        "npcs": {
          "items": {
            "$ref": "#/$defs/NpcInfo"
          },
          "type": "array"
        },
        "beats": {
          "items": {
            "$ref": "#/$defs/BeatInfo"
          },
          "type": "array"
        },
        "facts": {
          "items": {
            "$ref": "#/$defs/FactInfo"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "premise",
        "location",
        "npcs",
        "beats",
        "facts"
      ],
      "title": "CampaignView",
      "type": "object"
    },
    "Character": {
      "additionalProperties": false,
      "description": "Um personagem de jogador, com atributos, hp e inventário.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "attributes": {
          "additionalProperties": {
            "type": "integer"
          },
          "default": {},
          "type": "object"
        },
        "hp": {
          "type": "integer"
        },
        "max_hp": {
          "minimum": 0,
          "type": "integer"
        },
        "inventory": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "attributes",
        "hp",
        "max_hp",
        "inventory"
      ],
      "title": "Character",
      "type": "object"
    },
    "CheckPassed": {
      "additionalProperties": false,
      "description": "Algum personagem já passou (sucesso ou sucesso crítico) num teste desta habilidade.\n\nTestes de NPC não contam. Não exige local nem turno: combine com ``at_location`` etc.",
      "properties": {
        "kind": {
          "const": "check_passed",
          "type": "string"
        },
        "skill_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "skill_id"
      ],
      "title": "CheckPassed",
      "type": "object"
    },
    "CombatInfo": {
      "additionalProperties": false,
      "description": "As regras de combate que mudam o que a tela oferece.",
      "properties": {
        "default_weapon": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "fallen_can_act": {
          "type": "boolean"
        }
      },
      "required": [
        "default_weapon",
        "fallen_can_act"
      ],
      "title": "CombatInfo",
      "type": "object"
    },
    "CommandResult": {
      "additionalProperties": false,
      "description": "O resultado de um comando: o que ele produziu e como a mesa ficou.",
      "properties": {
        "revision": {
          "type": "integer"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/EventView"
          },
          "type": "array"
        },
        "text": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/GameStatus"
        },
        "turn_ended": {
          "type": "boolean"
        }
      },
      "required": [
        "revision",
        "events",
        "text",
        "status",
        "turn_ended"
      ],
      "title": "CommandResult",
      "type": "object"
    },
    "CopilotAnswer": {
      "additionalProperties": false,
      "description": "A resposta do copiloto, só para o anfitrião.",
      "properties": {
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "CopilotAnswer",
      "type": "object"
    },
    "DifficultyInfo": {
      "additionalProperties": false,
      "description": "Uma dificuldade e o valor que o teste precisa alcançar.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "value": {
          "type": "integer"
        }
      },
      "required": [
        "id",
        "name",
        "value"
      ],
      "title": "DifficultyInfo",
      "type": "object"
    },
    "ErrorResponse": {
      "additionalProperties": false,
      "description": "O corpo de toda resposta de erro.",
      "properties": {
        "error": {
          "$ref": "#/$defs/ApiError"
        }
      },
      "required": [
        "error"
      ],
      "title": "ErrorResponse",
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "description": "Entrada do log.\n\n``kind`` diz o tipo do evento e ``data`` traz os detalhes dele, que variam por tipo.",
      "properties": {
        "turn": {
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "type": "string"
        },
        "text": {
          "default": "",
          "type": "string"
        },
        "data": {
          "additionalProperties": true,
          "default": {},
          "type": "object"
        }
      },
      "required": [
        "turn",
        "kind",
        "text",
        "data"
      ],
      "title": "Event",
      "type": "object"
    },
    "EventView": {
      "additionalProperties": false,
      "description": "Um evento do log como o cliente o recebe.\n\nSem ``data``. ``prose`` é sempre a narração da gramática do próprio evento. ``narration`` é\no parágrafo do LLM para o lote de uma ação de texto livre, só no primeiro evento visível do\nlote (nos outros é ``None``). Os dois são exibição, nunca voltam ao estado, e são iguais para\ntodos os jogadores.\n\n``outcome`` é só o desfecho para o selo do feed: o grau de um teste (``success``...), de um\nataque (``hit``...), ``damage``/``incapacitated`` num dano e ``heal`` numa cura. ``None`` nos\ndemais eventos. O campo nunca leva dado, margem nem total (``data`` não sai); o ``text`` do evento é\noutra coisa e já mostra a rolagem a quem o vê.",
      "properties": {
        "index": {
          "type": "integer"
        },
        "turn": {
          "type": "integer"
        },
        "kind": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "prose": {
          "type": "string"
        },
        "narration": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "outcome": {
          "anyOf": [
            {
              "enum": [
                "critical_failure",
                "failure",
                "success",
                "critical_success",
                "critical_miss",
                "miss",
                "hit",
                "critical_hit",
                "damage",
                "incapacitated",
                "heal"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "index",
        "turn",
        "kind",
        "text",
        "prose",
        "narration",
        "outcome"
      ],
      "title": "EventView",
      "type": "object"
    },
    "EventsView": {
      "additionalProperties": false,
      "description": "Eventos e falas novos desde a última leitura, com as posições para a próxima.",
      "properties": {
        "revision": {
          "type": "integer"
        },
        "events": {
          "items": {
            "$ref": "#/$defs/EventView"
          },
          "type": "array"
        },
        "talk": {
          "items": {
            "$ref": "#/$defs/TalkView"
          },
          "type": "array"
        },
        "talk_seq": {
          "default": 0,
          "type": "integer"
        }
      },
      "required": [
        "revision",
        "events",
        "talk",
        "talk_seq"
      ],
      "title": "EventsView",
      "type": "object"
    },
    "ExitView": {
      "additionalProperties": false,
      "description": "Uma saída do local atual.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "ExitView",
      "type": "object"
    },
    "FactDef": {
      "additionalProperties": false,
      "description": "Informação da campanha que começa privada (só o anfitrião sabe) e pode virar pública.\n\n``about`` aponta um NPC, local, facção ou marco e serve só de rótulo de exibição.\n``reveal_when``: o motor revela o fato quando todas as condições valem; vazia, só o\nanfitrião revela, por comando. O estado guarda apenas quais fatos já foram revelados.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "about": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reveal_when": {
          "default": [],
          "items": {
            "discriminator": {
              "mapping": {
                "at_location": "#/$defs/AtLocation",
                "beat_done": "#/$defs/BeatDone",
                "check_passed": "#/$defs/CheckPassed",
                "npc_down": "#/$defs/NpcDown",
                "turn_at_least": "#/$defs/TurnAtLeast"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/AtLocation"
              },
              {
                "$ref": "#/$defs/NpcDown"
              },
              {
                "$ref": "#/$defs/BeatDone"
              },
              {
                "$ref": "#/$defs/TurnAtLeast"
              },
              {
                "$ref": "#/$defs/CheckPassed"
              }
            ]
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "text",
        "about",
        "reveal_when"
      ],
      "title": "FactDef",
      "type": "object"
    },
    "FactInfo": {
      "additionalProperties": false,
      "description": "Um fato já revelado.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "about": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "text",
        "about"
      ],
      "title": "FactInfo",
      "type": "object"
    },
    "Faction": {
      "additionalProperties": false,
      "description": "Uma facção da campanha.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "default": "",
          "type": "string"
        },
        "goals": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "private_notes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "goals",
        "private_notes"
      ],
      "title": "Faction",
      "type": "object"
    },
    "GameState": {
      "additionalProperties": false,
      "description": "O estado inteiro de uma partida: tudo que muda, em JSON puro.",
      "properties": {
        "state_version": {
          "const": 1,
          "default": 1,
          "type": "integer"
        },
        "campaign_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        "turn": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "rng_seed": {
          "type": "integer"
        },
        "rng_draws": {
          "default": 0,
          "minimum": 0,
          "type": "integer"
        },
        "current_location_id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        "characters": {
          "default": {},
          "patternProperties": {
            "^[a-z0-9][a-z0-9_-]*$": {
              "$ref": "#/$defs/Character"
            }
          },
          "type": "object"
        },
        "npcs": {
          "default": {},
          "patternProperties": {
            "^[a-z0-9][a-z0-9_-]*$": {
              "$ref": "#/$defs/NpcState"
            }
          },
          "type": "object"
        },
        "beats": {
          "default": {},
          "patternProperties": {
            "^[a-z0-9][a-z0-9_-]*$": {
              "$ref": "#/$defs/BeatStatus"
            }
          },
          "type": "object"
        },
        "revealed_facts": {
          "default": {},
          "patternProperties": {
            "^[a-z0-9][a-z0-9_-]*$": {
              "type": "integer"
            }
          },
          "type": "object"
        },
        "events": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Event"
          },
          "type": "array"
        }
      },
      "required": [
        "state_version",
        "campaign_id",
        "turn",
        "rng_seed",
