{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Beat": {
      "additionalProperties": false,
      "description": "Marco da trama. `requires` lista marcos que precisam estar concluídos antes.",
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "requires": {
          "default": [],
          "items": {
            "pattern": "^[a-z0-9][a-z0-9_-]*$",
            "type": "string"
          },
          "title": "Requires",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "title": "Beat",
      "type": "object"
    },
    "Faction": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "goals": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Goals",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Faction",
      "type": "object"
    },
    "Location": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "connections": {
          "default": [],
          "items": {
            "pattern": "^[a-z0-9][a-z0-9_-]*$",
            "type": "string"
          },
          "title": "Connections",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Location",
      "type": "object"
    },
    "Npc": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "location_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Location Id"
        },
        "faction_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9_-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Faction Id"
        },
        "secrets": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Secrets",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "Npc",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "title": "Id",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "premise": {
      "title": "Premise",
      "type": "string"
    },
    "rules_id": {
      "default": "default",
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "title": "Rules Id",
      "type": "string"
    },
    "start_location_id": {
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "title": "Start Location Id",
      "type": "string"
    },
    "locations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Location"
      },
      "title": "Locations",
      "type": "array"
    },
    "factions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Faction"
      },
      "title": "Factions",
      "type": "array"
    },
    "npcs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Npc"
      },
      "title": "Npcs",
      "type": "array"
    },
    "beats": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Beat"
      },
      "title": "Beats",
      "type": "array"
    }
  },
  "required": [
    "id",
    "title",
    "premise",
    "start_location_id"
  ],
  "title": "Campaign",
  "type": "object"
}
